#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running tests before push..."

# Run tests for the workspace
npm run test 2>&1

TEST_EXIT_CODE=$?

# Allow push if tests pass (exit code 0)
# Allow push if tests don't exist yet (exit code 1 but no test files)
# Reject push only if tests fail with actual test code
if [ $TEST_EXIT_CODE -eq 0 ]; then
  echo "✅ All tests passed. Proceeding with push."
  exit 0
fi

# Check if failure is due to missing test files (Phase 0)
if npm run test 2>&1 | grep -q "No test files found"; then
  echo "⚠️  No test files found yet. Allowing push during early development."
  echo "✅ Proceeding with push."
  exit 0
fi

echo "❌ Tests failed. Push aborted."
exit 1
